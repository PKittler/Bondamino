# Kept out of the Docker build context: repository metadata, caches and local data or
# configuration (secrets, database, uploads, collected static files) of a standalone installation.
.git
.github
.idea
**/__pycache__
**/*.pyc
bondamino/.env
bondamino/.env.*
!bondamino/.env.example
bondamino/db.sqlite3
bondamino/media
bondamino/staticfiles
.env
