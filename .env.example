# Bondamino configuration – template.
#
# Standalone: copy to bondamino/.env, or let "python manage.py setup" write it.
# Docker Compose: copy to .env next to docker-compose.yml.
# Portainer: enter the variables under "Environment variables" of the stack.
# Values must not be quoted. Empty values use the default.
# All variables are described in INSTALL.md, section "Configuration reference".

# --- Docker Compose / Portainer only -------------------------------------------
# Password of the database user (letters and digits only; e.g. generated with
# python -c "import secrets; print(secrets.token_hex(24))")
DB_PASSWORD=
# Address and port on the host. 127.0.0.1:8000 = only from this computer (reverse proxy on the
# same host). 8000 = from other computers too; then do not set HTTPS=1 (see INSTALL.md).
BONDAMINO_PORT=127.0.0.1:8000
# Web server processes and request timeout in seconds
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# First administrator, created on the first start if there is none yet.
# Remove ADMIN_PASSWORD afterwards; it would otherwise stay in the container configuration.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Standalone only -------------------------------------------------------------
# sqlite:///db.sqlite3 | postgres://user:password@host:5432/bondamino
# mariadb://user:password@host:3306/bondamino   (URL-encode special characters)
DATABASE_URL=sqlite:///db.sqlite3

# --- All --------------------------------------------------------------------------
# Secret key: long random value, keep it secret. Docker: leave empty, it is generated
# on the first start and stored in the data volume.
SECRET_KEY=
# Domain(s) under which Bondamino is reached, comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1
# 1 = served via HTTPS through a reverse proxy (secure cookies, X-Forwarded-Proto; the client
# address for limiting sign-in attempts is taken from X-Forwarded-For)
HTTPS=0
# Only needed if the reverse proxy changes the host name, e.g. https://bondamino.example.org
CSRF_TRUSTED_ORIGINS=
# Default time zone for dates and times (IANA name, e.g. Europe/Berlin); users can choose
# their own in their account settings
TIME_ZONE=UTC
# 1 = development mode. Never on a public server.
DEBUG=0

# Email (invitations, forgotten passwords). Without EMAIL_BACKEND emails are only printed
# in the server console (Docker: docker compose logs). To send them, set
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the mail server below.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Bondamino <noreply@example.org>

# --- Logging and database connections ---------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=WARNING
# Seconds a database connection is reused
CONN_MAX_AGE=60
